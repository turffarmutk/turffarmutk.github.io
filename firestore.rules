rules_version = '2';

/* ============================================================================
   UT TURF FARM — database rules
   ----------------------------------------------------------------------------
   THIS FILE IS A TRANSCRIPTION OF ONE FUNCTION.

   `taskCan(actor, action, task)` in UT-TurfFarm-App.html is the farm's
   organisation chart written as code. It decides which buttons the app offers.
   THIS FILE decides what the database will actually accept — and the database
   is the one nobody can get around by knowing where to tap.

   The two must read identically. If they drift, the copy that drifted is the
   one that lets somebody put work on a person who does not answer to them.
   `tools/test-rules.js` runs both against every person-to-person pair on the
   roster and fails if they ever disagree. Change one, change the other, run
   `npm test`.

   Nothing in this file is enforced until it is published in the Firebase
   console — see docs/PUBLISH-THE-RULES.md.

   Anything not explicitly allowed below is denied. That is Firestore's
   default and it is deliberate: a drawer that has not been built yet is
   closed, not open.
   ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------
       WHO IS ASKING

       The roster id ("p09") travels on the sign-in token as a custom claim,
       stamped there by tools/create-accounts.js. The account holder cannot
       edit it, and it is readable with no signal because it is cached with
       the token. The crew's email addresses are deliberately not in the app,
       so the id is the only thing that identifies a person here.
       ------------------------------------------------------------------ */
    function me() {
      return request.auth != null && request.auth.token.pid is string
        ? request.auth.token.pid : '';
    }
    function signedIn() {
      return me() != '';
    }

    /* ------------------------------------------------------------------
       THE ROSTER — one document, refdata/roster

       Read as ONE document rather than one per person, on purpose: a rule
       may only fetch a handful of documents per request, and the whole
       roster is 23 short entries. Repeated lookups inside one request are
       fetched once and reused, so this costs a single read no matter how
       many times the rules below ask a question about somebody.

       Shape:
         { people: { p01: {role, lab, active, grants[]}, ... } }
       ------------------------------------------------------------------ */
    function rec(id) {
      return get(/databases/$(database)/documents/refdata/roster).data.people.get(id, {});
    }
    function str(v) {
      return v == null ? '' : v;
    }
    function roleOf(id)   { return str(rec(id).get('role', '')); }
    function grantsOf(id) { return rec(id).get('grants', []); }

    /* On the roster at all. A blank role means the person is not in it. */
    function known(id) {
      return id != '' && roleOf(id) != '';
    }
    /* App: `p.active !== false` — present and not switched off. */
    function activeOf(id) {
      return known(id) && rec(id).get('active', true) == true;
    }

    /* Two people share a lab only if they actually have one. A blank lab
       (or the em dash the app writes for "none") is the shared undergrad
       pool, not a lab everybody is in together. */
    function labOf(id) {
      return str(rec(id).get('lab', '')) == '—' ? '' : str(rec(id).get('lab', ''));
    }
    function sameLab(a, b) {
      return labOf(a) != '' && labOf(a) == labOf(b);
    }

    /* Handing out undergrad labour is a GRANT on a person, not a test for
       the words "Farm Manager", because it moves: Bill needs to be able to
       hand the job to somebody while he is away, and Dillon holds it today. */
    function assignsUndergrads(id) {
      return roleOf(id) == 'Farm Manager' || grantsOf(id).hasAny(['assign_undergrads']);
    }

    /* The gate every rule below starts with: signed in, on the roster, not
       switched off. Matches the first two lines of taskCan(). */
    function actor() {
      return signedIn() && activeOf(me());
    }

    /* ------------------------------------------------------------------
       THE FOUR BRANCHES OF taskCan()
       ------------------------------------------------------------------ */

    /* create / request — undergrads do the work they are given; they do
       not raise it. */
    function canCreate() {
      return roleOf(me()) != 'Undergraduate Student';
    }

    /* assign — putting a NAMED person on a job. Everything turns on this.
       Read it against the switch in taskCan(): same order, same answers. */
    function canAssignTo(target) {
      return target == '' ? false
        : target == me() ? roleOf(me()) != 'Undergraduate Student'
        : roleOf(target) == 'Undergraduate Student' ? canDirectUndergrad(target)
        : roleOf(me()) == 'Faculty'
          ? ((roleOf(target) == 'Graduate Student' || roleOf(target) == 'Technician')
             && sameLab(me(), target))
        : false;
    }

    /* THE LAB-ASSIGNED EXCEPTION — Dillon, 2026-08-25.
       An undergrad who belongs to a lab answers to that lab, so anybody in it
       above undergrad may direct them: faculty, grad students and technicians
       alike. The five pooled undergrads carry Bill's own lab, so the pool is
       untouched by this and still goes through whoever holds the job. */
    function canDirectUndergrad(target) {
      return assignsUndergrads(me())
        || (roleOf(me()) != 'Undergraduate Student' && sameLab(me(), target));
    }

    /* claim — picking up something nobody is on. Undergrads never see the
       pool, so they can never take from it. */
    function canClaim(d) {
      return str(d.get('assignee', '')) == ''
        && (roleOf(me()) == 'Graduate Student'
            || roleOf(me()) == 'Technician'
            || assignsUndergrads(me()));
    }

    /* complete — the worker closes their own; whoever holds the undergrad
       job may close on their behalf. A job can carry more than one person:
       `assignee` is the primary and `helpers` is everyone else on it. */
    function onTask(d, id) {
      return id != '' && (str(d.get('assignee', '')) == id || d.get('helpers', []).hasAny([id]));
    }
    function canComplete(d) {
      return onTask(d, me()) || assignsUndergrads(me());
    }

    /* edit / delete — Bill, the person who raised it, or faculty over work
       sitting on their own lab's person. */
    function canEdit(d) {
      return roleOf(me()) == 'Farm Manager'
        || str(d.get('createdBy', '')) == me()
        || (roleOf(me()) == 'Faculty'
            && str(d.get('assignee', '')) != ''
            && sameLab(me(), str(d.get('assignee', ''))));
    }

    /* ------------------------------------------------------------------
       THE ROSTER DOCUMENT ITSELF

       Everyone signed in may read it — the app needs names and roles on
       every screen. Only the person holding the undergrad-assignment job
       may rewrite it, which is the same grant that governs task assignment.

       The two ids below are the bootstrap: the roster has to be written
       once before any rule above can read it, and until it exists there is
       nothing to check a grant against. p07 is Bill, p01 is Dillon. This is
       the ONLY place in the whole file where a person is named, and if both
       ever leave the farm it is the one line a successor has to change.
       ------------------------------------------------------------------ */
    match /refdata/roster {
      allow read: if signedIn();
      allow write: if signedIn() && (
           me() in ['p01', 'p07']
        || (exists(/databases/$(database)/documents/refdata/roster) && assignsUndergrads(me()))
      );
    }

    /* ------------------------------------------------------------------
       TASKS — drawer 1

       Reading is open to everyone signed in. The task board is the shared
       picture of the farm's day; hiding other people's jobs would break
       the pool, the "who else is out here" row, and Bill's overview.
       (Trials are lab-scoped; tasks are not. That is deliberate and it is
       flagged in docs/BACKEND-STEPS.md as a question for Dillon.)
       ------------------------------------------------------------------ */
    match /tasks/{taskId} {

      /* --- claim: nobody was on it, now I am --- */
      function isClaim() {
        return changed().hasOnly(['assignee', 'status', 'kind', 'origin', 'claimedAt', 'updatedAt'])
          && str(request.resource.data.get('assignee', '')) == me()
          && canClaim(resource.data);
      }

      /* --- completion: credit goes to the WORKER, not to whoever closed
             it. completedBy must be somebody who was actually on the job,
             or the person pressing the button. --- */
      function isCompletion() {
        return changed().hasOnly(['status', 'completedBy', 'completedAt', 'closedBy',
                                  'done', 'units', 'updatedAt'])
          && canComplete(resource.data)
          && str(request.resource.data.get('completedBy', '')) != ''
          && (onTask(resource.data, str(request.resource.data.get('completedBy', '')))
              || str(request.resource.data.get('completedBy', '')) == me());
      }

      /* --- assignment: the person on the job changes --- */
      function isAssignment() {
        return changed().hasOnly(['assignee', 'helpers', 'kind', 'origin', 'target',
                                  'assignedBy', 'requestedBy', 'students', 'status', 'updatedAt'])
          && canAssignTo(str(request.resource.data.get('assignee', '')));
      }

      /* --- ordinary edit: anything else about the job. If it also moves
             the job to a different person, that move has to pass the
             assign rule on its own. --- */
      function isEdit() {
        return canEdit(resource.data)
          && (str(request.resource.data.get('assignee', '')) == str(resource.data.get('assignee', ''))
              || canAssignTo(str(request.resource.data.get('assignee', ''))));
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow read: if actor();

      /* The id in the record must match the id of the document, so a task
         cannot be filed under one name and claim to be another. createdBy
         is stamped here and can never be rewritten (see update below), so
         "I raised this" stays true forever. */
      allow create: if actor()
        && canCreate()
        && request.resource.data.id == taskId
        && str(request.resource.data.get('createdBy', '')) == me()
        && (str(request.resource.data.get('assignee', '')) == ''
            || canAssignTo(str(request.resource.data.get('assignee', ''))));

      /* An update is one of four moves. Each is checked against the branch
         of taskCan() that governs it, and the narrow moves may only touch
         the fields that move actually changes — so "I am claiming this"
         cannot quietly also rewrite the job. */
      allow update: if actor()
        && request.resource.data.id == resource.data.id
        && str(request.resource.data.get('createdBy', '')) == str(resource.data.get('createdBy', ''))
        && (isClaim() || isCompletion() || isAssignment() || isEdit());

      allow delete: if actor() && canEdit(resource.data);

    }

    /* ------------------------------------------------------------------
       THE MAP — drawer 2

       One document per place that somebody has CHANGED. A place nobody has
       touched has no document at all, and what is stored is the change, not
       the finished object — so farm-geo.js is never shadowed and a corrected
       area in the file still reaches everybody.

       Who may change it: anyone but an undergrad. Dillon, 2026-08-25. Before
       this the app had three different answers for reshaping, plot
       information and the mowing setup; one rule is easier to explain, and
       what it protects against is a wrong number staying wrong because the
       person who spotted it had to go and find somebody.

       Transcribed from mapCan() in the app. Same warning as taskCan(): one
       rule, two places, and the copy that drifts is the one that causes harm.
       ------------------------------------------------------------------ */
    function canMap() {
      return roleOf(me()) != 'Undergraduate Student';
    }

    match /mapplaces/{placeId} {
      allow read: if actor();
      allow create, update: if actor()
        && canMap()
        && request.resource.data.id == placeId
        && str(request.resource.data.get('updatedBy','')) == me();
      /* Nothing deletes a map record. Removing a PLACE is expressible without
         it (`removed: true`), and "clear this device's edits" must never be
         able to take the farm's corrections with it. */
      allow delete: if false;
    }

    /* ------------------------------------------------------------------
       CREW CLAIMS — who is working which piece of ground

       When two or three people share a mow, each zone or plot is claimed by
       one of them so the same ground is not worked twice. One document per
       task, holding a claim per unit, so two people claiming different zones
       write different fields and cannot overwrite each other.

       Anybody on the roster may read: the point is seeing who else is out
       there. Writing is for people actually on that job — or whoever holds
       the undergrad-assignment job, who may be sorting it out from the shed.
       A task with no record in the database yet is not a reason to refuse:
       tasks and the map are separate drawers and either may be switched over
       first.
       ------------------------------------------------------------------ */
    function taskHere(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }
    function onThisJob(taskId) {
      return !exists(/databases/$(database)/documents/tasks/$(taskId))
          || str(taskHere(taskId).get('assignee','')) == me()
          || taskHere(taskId).get('helpers', []).hasAny([me()])
          || assignsUndergrads(me());
    }

    match /crew/{taskId} {
      allow read: if actor();
      /* Undergrads claim ground too — being out on the mow is exactly who
         this is for. The gate is being on the job, not the person's rank. */
      allow create, update: if actor() && onThisJob(taskId);
      allow delete: if false;
    }

    /* ------------------------------------------------------------------
       THE FIELD LOG — drawer 3

       The record that outlives everybody currently on the farm, and the one
       somebody will read in 2035 to answer a question nobody has thought of
       yet. Two rules follow from that, and they are the whole block:

       NOTHING IS EVER DELETED. Not by anybody, ever. `allow delete: if false`.

       NOTHING IS EVER EDITED. A correction writes a NEW entry carrying the
       fix; the only change ever made to an existing entry is the three fields
       that mark it as superseded by that new one. Dillon, 2026-08-25: the
       wrong entry stays. The spray entries are the farm's application records,
       and a log that can be quietly rewritten is worth much less than one
       where you can see what changed and when.

       Transcribed from flCan() in the app.
       ------------------------------------------------------------------ */
    function logEntry() {
      return resource.data;
    }
    /* Who wrote it down, whose work it was, Bill, or faculty over their own
       lab's person. Mirrors flCan(…,'correct',…) exactly. */
    function canCorrectLog() {
      return str(logEntry().get('correctedBy','')) == ''
        && ( str(logEntry().get('loggedBy','')) == me()
          || str(logEntry().get('person','')) == me()
          || assignsUndergrads(me())
          || (roleOf(me()) == 'Faculty'
              && str(logEntry().get('person','')) != ''
              && sameLab(me(), str(logEntry().get('person','')))) );
    }

    match /fieldlog/{entryId} {
      allow read: if actor();

      /* Everybody logs their own work — an undergrad who mowed is exactly the
         person who should be recording that they mowed. */
      allow create: if actor()
        && request.resource.data.id == entryId
        && str(request.resource.data.get('loggedBy','')) == me();

      /* The ONLY permitted change to an entry that already exists: marking it
         superseded by the correction that replaced it. */
      allow update: if actor()
        && canCorrectLog()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['correctedBy', 'correctedAt', 'correctedWho'])
        && str(request.resource.data.get('correctedWho','')) == me()
        && str(request.resource.data.get('correctedBy','')) != '';

      allow delete: if false;
    }

    /* ------------------------------------------------------------------
       INVENTORY — drawer 4, two collections

       invmoves is the LEDGER and it is APPEND ONLY. Stock is not stored as a
       number anywhere; it is stored as what moved, and every phone adds the
       movements up itself. That is what makes two people booking a delivery
       at the same moment safe: two documents, both counted, nothing
       overwritten. It is also why there is no update rule below — a movement
       records something that happened, and a mistake is corrected by ANOTHER
       movement, never by rewriting the first. Same rule as the field log.

       invitems is what a product IS: its name, what a container holds, when
       to reorder. Those genuinely change, so they may be updated — but only
       by somebody the app already lets edit a product.

       TWO PERMISSIONS, transcribed from the app. invCanMove() and
       invCanEdit() are the functions; these are their translation, and the
       two must never drift apart.
       ------------------------------------------------------------------ */

    /* App: invCanMove() — true for EVERYBODY, undergraduates included. The
       people who carry the jugs are the people who know what left the shelf,
       and the field log already trusts them to write the farm's spray
       records. */
    function canMoveStock() {
      return actor();
    }

    /* App: invCanEdit() — deciding what a product is, rather than recording
       what happened to it. */
    function canEditProduct() {
      return actor() && roleOf(me()) != 'Undergraduate Student';
    }

    match /invmoves/{moveId} {
      allow read: if actor();

      allow create: if canMoveStock()
        && request.resource.data.id == moveId
        && request.resource.data.item is string
        && request.resource.data.delta is number
        && str(request.resource.data.get('who','')) == me();

      /* Correct it with another movement. Never rewrite this one. */
      allow update: if false;
      allow delete: if false;
    }

    match /invitems/{itemId} {
      allow read: if actor();
      allow create, update: if canEditProduct()
        && request.resource.data.id == itemId;
      allow delete: if false;
    }

    /* ------------------------------------------------------------------
       SCHEDULES — drawer 5

       One document per person per semester: the standing weekly hours an
       undergrad sets on their own profile. The day board is drawn from these,
       which is the whole reason they leave the phone at all.

       Transcribed from schedCanEdit() in the app. The two must never drift.
       ------------------------------------------------------------------ */

    /* App: schedCanEdit(pid). Your own is yours. Bill may fix anybody's,
       because he is the one who notices the board is wrong while the student
       is out in a field. Faculty may fix their own lab's, matching the fact
       that they may already direct those people. */
    function canSetSchedule(pid) {
      return actor()
        && ( pid == me()
          || assignsUndergrads(me())
          || (roleOf(me()) == 'Faculty' && sameLab(me(), pid)) );
    }

    match /schedules/{schedId} {
      /* Readable by everybody signed in. Who is on the farm on Thursday is
         not private information here — it is the rota. */
      allow read: if actor();

      allow create, update: if canSetSchedule(str(request.resource.data.get('pid','')))
        && request.resource.data.id == schedId
        && request.resource.data.pid is string
        && request.resource.data.sem is string
        && request.resource.data.days is map;

      /* Turning every day off is how you say "not this term". There is no
         reason to remove the record, and removing it would silently drop
         whatever the shared copy knew. */
      allow delete: if false;
    }

    /* ------------------------------------------------------------------
       TIME CLOCK — drawer 6

       One document per punch. NOT append-only, and that is deliberate rather
       than an oversight: a punch is closed by writing its clock-out time onto
       the record that was opened hours earlier, and a wrong time on a
       timesheet has to be correctable by the person who signs it. So updates
       are allowed, narrowly.

       Transcribed from tcCanPunchFor() and tcCanEditPunches().
       ------------------------------------------------------------------ */

    function punchRec() { return resource.data; }

    /* App: tcCanPunchFor(pid) — you clock yourself; Bill may clock or correct
       anybody, which is what the "add a punch" and time-wheel controls on his
       screen have always done. */
    function canPunchFor(pid) {
      return actor() && (pid == me() || assignsUndergrads(me()));
    }

    match /punches/{punchId} {
      allow read: if actor();

      allow create: if canPunchFor(str(request.resource.data.get('pid','')))
        && request.resource.data.id == punchId
        && request.resource.data.pid is string
        && request.resource.data.date is string;

      /* Closing your own shift, or Bill correcting a time. The owner may not
         be changed by an update — that would move somebody else's hours onto
         your name, which is the one thing worth spelling out here. */
      allow update: if canPunchFor(str(punchRec().get('pid','')))
        && str(request.resource.data.get('pid','')) == str(punchRec().get('pid',''))
        && request.resource.data.id == punchId;

      /* Removing a punch is a payroll correction, so it is Bill's alone. The
         field log and the stock ledger never delete anything; this one does,
         because a punch somebody opened by mistake at 6am is not a record of
         work and leaving it there is not honesty, it is a wrong timesheet. */
      allow delete: if actor() && assignsUndergrads(me());
    }

    /* ------------------------------------------------------------------
       THE TASK LIST — drawer 7

       The jobs the farm does, as opposed to the jobs somebody has been given.
       The assign screen is built from this, so a job that is not here is a job
       nobody can hand out.

       Transcribed from tplCanEdit() in the app.
       ------------------------------------------------------------------ */

    /* App: tplCanEdit() — everybody but the undergraduates, the same line
       invCanEdit() draws. Doing a job and deciding what the job IS are two
       different things. Undergrads read it: looking up what the work you have
       been handed actually involves is the point of having it. */
    function canEditTaskList() {
      return actor() && roleOf(me()) != 'Undergraduate Student';
    }

    match /templates/{tplId} {
      allow read: if actor();

      allow create, update: if canEditTaskList()
        && request.resource.data.id == tplId
        && request.resource.data.name is string;

      /* Taking a job off the list is an UPDATE that sets removed:true, never a
         deleted document — see the note in the app's sync module. A phone that
         has been switched off still holds its own copy of the list, and on
         reconnecting it pushes up everything the shared copy is missing; a
         genuinely deleted job would come straight back. A tombstone travels,
         so it stays gone. Nothing needs to delete here, so nothing may. */
      allow delete: if false;
    }

    /* ------------------------------------------------------------------
       TRIALS AND RESTRICTIONS

       Two collections, and the split is the whole point.

       Reading is open to everyone signed in, like tasks and the field log. The
       app still shows an undergraduate only the ACTIVE studies, and still keeps
       one lab's planned work off another lab's screen -- but that is a tidy
       screen, not a lock, and it is written down here so nobody mistakes it for
       one. Anything on the shared copy is on every signed-in phone.

       WRITING splits in two, because Dillon's rule has two halves that the
       database has to be able to tell apart:

         trials/{id}       a study. Only that study's own lab may write it --
                           the protocol, the stage, the plots, the restrictions
                           it carries. Bill may not.
         triallifts/{rid}  one small record saying a restriction has been
                           lifted. That study's lab may write one, and so may
                           whoever runs the farm.

       If the lift lived inside the study document, "Bill may lift a restriction
       but may not change the study" would be unenforceable: a rule that lets
       him write the document to lift one restriction lets him rewrite every
       other word in it in the same breath, and nothing here could tell the
       difference. Split out, the rule is exactly as narrow as the sentence.
       ------------------------------------------------------------------ */

    /* App: trCanEditLab() -- the person's own lab off the roster, plus any lab
       carried as a 'trials:<Lab>' grant (Dr. Stier also edits Sorochan). The
       undergraduates get none: doing the work and deciding what the study IS
       are two different things, the same line canEditTaskList() draws. */
    function canEditTrialLab(lab) {
      return actor()
        && roleOf(me()) != 'Undergraduate Student'
        /* The Farm Manager edits no study at all -- he lifts, and that is the
           whole of it. He carries the lab the pooled undergraduates hang on,
           which without this line would read as a lab he could file under. */
        && roleOf(me()) != 'Farm Manager'
        && lab is string && lab != '' && lab != '—'
        && (labOf(me()) == lab || grantsOf(me()).hasAny(['trials:' + lab]));
    }

    /* App: trCanLiftAny() -- the Farm Manager, or whoever is holding that job
       while he is away. A role plus a movable grant, for the same reason
       assignsUndergrads() is one: ground fenced off by a study nobody is
       running any more has to be freeable without a code change. */
    function liftsRestrictions() {
      return actor()
        && (roleOf(me()) == 'Farm Manager' || grantsOf(me()).hasAny(['lift_restrictions']));
    }

    match /trials/{trialId} {
      allow read: if actor();

      allow create: if canEditTrialLab(request.resource.data.lab)
        && request.resource.data.id == trialId;

      /* Both labs have to be yours: the one the study is in, and the one it
         would be in afterwards. Otherwise a study could be walked out of a lab
         one save at a time. */
      allow update: if canEditTrialLab(request.resource.data.lab)
        && canEditTrialLab(resource.data.lab)
        && request.resource.data.id == trialId;

      /* Removing a study is an UPDATE that sets removed:true, never a deleted
         document -- the same tombstone the task list uses, and for the same
         reason. A phone that was switched off still holds its own copy of every
         study; on reconnecting it offers up whatever the shared copy lacks, and
         a genuinely deleted study would come straight back. */
      allow delete: if false;
    }

    match /triallifts/{restrictionId} {
      allow read: if actor();

      /* The lab lifts its own; whoever runs the farm lifts anybody's. There is
         nothing else in this document to abuse: it carries the restriction id,
         which study and lab it belongs to, the date, and who lifted it. */
      allow create, update: if (canEditTrialLab(request.resource.data.lab) || liftsRestrictions())
        && request.resource.data.id == restrictionId
        && request.resource.data.lifted is string
        && request.resource.data.lifted != '';

      /* Un-lifting is not a thing the app does. A restriction that should be
         back on is a new restriction, with its own dates and its own author. */
      allow delete: if false;
    }

    /* ------------------------------------------------------------------
       FARM SETTINGS

       Four small things rather than a list of records, so this block is shaped
       differently: ONE DOCUMENT PER GROUP, and the group's name IS the document
       id. `farmsettings/spray`, `/mowers`, `/labs`, `/semesters`.

       `v` carries the value, and `v: null` means "back to the built-in
       defaults" -- a real answer, not an absence. A reset that travelled as a
       deleted document would be undone by the next phone to connect, which
       still holds its own copy.

       Reading is open to everyone signed in. It has to be: the sprayer numbers
       feed the mix calculator on the phone of whoever is spraying, and the
       semester dates decide whose weekly hours count today.
       ------------------------------------------------------------------ */

    /* App: fstCanEditKit() -- the sprayer numbers and the mower list. The
       people who spray and mow are the people who know them, so this is
       everybody but the undergraduates, the same line canEditTaskList() draws.
       Dillon added faculty to the whole of Farm settings on 2026-08-26. */
    function canEditFarmKit() {
      return isAppManager() || (actor() && roleOf(me()) != 'Undergraduate Student');
    }

    /* App: fstCanEditLists() -- the labs list and the semester dates. These two
       decide who belongs where and when the farm is running, and renaming a lab
       moves people and studies with it. Bill, faculty, or the App Manager. */
    function canEditFarmLists() {
      return isAppManager()
        || (actor() && (roleOf(me()) == 'Farm Manager' || roleOf(me()) == 'Faculty'));
    }

    /* The App Manager post is the one thing here that is NOT on the roster: it
       rides on the sign-in token as its own claim, stamped by
       tools/create-accounts.js, exactly like `pid`. That is why a rule can ask
       about it directly. App: rstIsAdmin(). */
    function isAppManager() {
      return request.auth != null && request.auth.token.app_admin == true;
    }

    match /farmsettings/{group} {
      allow read: if actor();

      allow create, update: if request.resource.data.id == group
        && (
             ((group == 'spray' || group == 'mowers') && canEditFarmKit())
          || ((group == 'labs'  || group == 'semesters') && canEditFarmLists())
        );

      /* A group that is not one of the four is not a settings group. Anything
         else here would be a document nothing reads and nothing maintains. */
      allow delete: if false;
    }

    /* ------------------------------------------------------------------
       EVERYTHING ELSE IS CLOSED.

       Calendar and equipment get their own blocks here as each drawer is
       built. Tasks, the map, crew claims, the field log, inventory, the
       weekly schedules, the time clock, the task list, the trials and farm
       settings already have theirs. Until then the database
       refuses them, which is what we want: an empty drawer nobody can
       write into beats an open one nobody is watching.
       ------------------------------------------------------------------ */
  }
}
